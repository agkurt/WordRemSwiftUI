# marketing/.env (repoya gönderilmez). Değerleri kendin yaz; sohbete yapıştırma.

# Instagram: developers.facebook.com → uygulaman → Instagram → "API setup with Instagram login" → Generate token
IG_ACCESS_TOKEN=

# TikTok: developers.tiktok.com → uygulaman → Credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Uygulamada Login Kit'e kayıtlı yönlendirme adresiyle birebir aynı olmalı
TIKTOK_REDIRECT_URI=https://api.wordremai.app/tiktok/callback

# Öğrenci sesi (kurguda OpenAI TTS): platform.openai.com → API keys; kullanım limiti koy
OPENAI_API_KEY=

# Bulut zamanlayıcısı (marketing/cloud): CLOUD_URL deploy bitince, CLOUD_TOKEN = worker ADMIN_TOKEN, NTFY_TOPIC = telefondaki ntfy konusu
CLOUD_URL=
CLOUD_TOKEN=
NTFY_TOPIC=
